# Production / dash.{store}.mel.iq — leave empty so requests use /api/v1 via Gateway
# VITE_API_BASE_URL=
# VITE_API_BASE_URL=/api/v1

# Localhost tenant slug (required when hostname has no subdomain)
VITE_TENANT_SUBDOMAIN=hasan

# Local direct backend (bypasses Gateway / Vite proxy):
# VITE_API_BASE_URL=http://localhost:3000/api/v1

# Vite proxy upstream when using relative /api/v1 in dev:
# VITE_API_PROXY_TARGET=https://api.mel.iq

VITE_API_BASE_URL=

